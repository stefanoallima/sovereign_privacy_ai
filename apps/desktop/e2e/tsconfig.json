{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["@playwright/test", "node"],
    "typeRoots": ["../node_modules/@types", "../node_modules"]
  },
  "include": ["./**/*.ts"],
  "exclude": []
}
